# Servidor Local
PORT=3000
HOST=127.0.0.1

# Diretor de Cena (Opcional - sobrescreve preferência herdada do config.toml legado)
# Provedores suportados / planejados: gemini, groq, openai, openrouter, local_mock
DIRECTOR_PROVIDER=
DIRECTOR_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Síntese de Voz (Opcional - padrão é Piper local, ou provedor externo)
# Provedores suportados / planejados: piper, minimax, elevenlabs
TTS_PROVIDER=
MINIMAX_API_KEY=
ELEVENLABS_API_KEY=
